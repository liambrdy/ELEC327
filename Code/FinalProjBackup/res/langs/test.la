#include "types.h"

#define X 12
#define RET_MSG "hello world"

typedef struct ret_t {
    i32 ret;
    u8 *msg;
    u8 c;
} ret_t;

typedef enum ret_code {
    RET_SUCCESS = 15,
    RET_FAIL,
} ret_code;

int main() {
    ret_t s = {
        .ret = X,
        .msg = RET_MSG,
        .c = 'a',
    };

    int *const* a;

    for (int i = 0; i < 4; i++) {
        printf("%d\n", i);
    }

    ret_code c = RET_SUCCESS;
    
    printf(s.msg);
    return s.ret;
}